# Copy to .env and fill in. NEVER commit real values.
# --- Backend (Render) ---
DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-us-west-1.pooler.supabase.com:6543/postgres
NWS_USER_AGENT=(fishing-app-dev, you@example.com)
ALLOWED_ORIGINS=*
# --- Ocean data storage (local folder in dev; Cloudflare R2 in production) ---
STORAGE=local
LOCAL_DATA_DIR=data
PUBLIC_DATA_URL=http://localhost:8000/data
R2_BUCKET=fishing-app-data
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# --- Dataset overrides (only if `python -m ocean.jobs verify` says a default moved) ---
SST_DATASET=
CHL_DATASET=
# --- Mobile (public values only; these ship inside the app) ---
EXPO_PUBLIC_API_URL=https://your-api.onrender.com
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=public-anon-key-here
