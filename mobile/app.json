{
  "expo": {
    "name": "Channel Nav",
    "slug": "socal-fishing-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#EEF2F6",
    "ios": {
      "bundleIdentifier": "com.cassullo.channelnav",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Shows your boat's position, speed and course on the chart, and measures distance and bearing to spots.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Keeps recording your trip track, and keeps your fishing group updated with your boat's position while you choose to share it, when the screen is off. Background location is only used while a recording or sharing is on.",
        "NSMotionUsageDescription": "Uses the compass to show which way your boat is pointing.",
        "NSCameraUsageDescription": "Take photos of your catch to add to your fishing log.",
        "NSPhotoLibraryUsageDescription": "Add catch photos from your library.",
        "UIBackgroundModes": [
          "location",
          "remote-notification"
        ]
      },
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.cassullo.channelnav",
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0E2D52"
      }
    },
    "plugins": [
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Shows your boat's position, speed and course on the chart, and measures distance and bearing to spots.",
          "locationAlwaysAndWhenInUsePermission": "Keeps recording your trip track, and keeps your fishing group updated with your boat's position while you choose to share it, when the screen is off. Background location is only used while a recording or sharing is on.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Add catch photos from your library.",
          "cameraPermission": "Take photos of your catch to add to your fishing log."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F5A524"
        }
      ],
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0B2A40",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#06182A"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "46ce8aa2-93f1-45ee-9ef9-828acdcf180c"
      }
    },
    "icon": "./assets/icon.png",
    "owner": "channel-nav",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/46ce8aa2-93f1-45ee-9ef9-828acdcf180c",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
